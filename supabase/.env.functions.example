# Built-in SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are provided by Supabase.
ALLOWED_ORIGIN=http://127.0.0.1:4321
# Generate a long random secret for a scheduler calling the private dispatch action.
EMAIL_DISPATCH_SECRET=
# Provider-neutral HTTPS email adapter; see README for payload and retry contract.
EMAIL_WEBHOOK_URL=
EMAIL_WEBHOOK_TOKEN=
# Set true only for local development with no email provider.
ALLOW_EMAIL_QUEUE_ONLY=false
