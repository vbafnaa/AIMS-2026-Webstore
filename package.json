    "test:browser": "node tests/browser.mjs"
  },
  "dependencies": {
    "@astrojs/react": "5.0.4",
    "@tailwindcss/vite": "4.2.4",
    "astro": "6.1.10",
    "lucide-react": "1.14.0",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "tailwindcss": "4.2.4"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "playwright": "1.63.0",
    "sharp": "0.34.5",
    "typescript": "5.9.3"
  }
}
